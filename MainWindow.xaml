<Window x:Class="TaskManager_Khodzhiev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager_Khodzhiev"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        FontFamily="Century Gothic"
        WindowStyle="None">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Update">
            <Setter Property="Background" Value="AliceBlue"/>
            <Setter Property="BorderBrush" Value="AliceBlue"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="{x:Type Button}" x:Key="Close">
            <Setter Property="Background">
                <Setter.Value>
                    <ImageBrush ImageSource="/Images/close.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#00FFFF00"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <Grid Height="50" VerticalAlignment="Top" Background="White">
            <Grid.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.5"/>
            </Grid.Effect>
            <Image Source="/Images/sticky-note.png" HorizontalAlignment="Left" Width="30" Height="30" Margin="10"/>
            <Label Content="Задачник" VerticalContentAlignment="Center" Margin="50,0,0,0" HorizontalContentAlignment="Left" FontSize="18"/>
            <TextBox Text="{Binding vm_tasks.SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="26" Margin="175,0,250,0"/>
            <Button Command="{Binding vm_tasks.Sort}" Style="{StaticResource Update}" Content="Приоритет" Height="26" Width="105" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,50,0"/>
            <Button Style="{StaticResource Close}" Margin="10" Command="{Binding OnClose}" Width="15" Height="15" HorizontalAlignment="Right"/>
        </Grid>
        <Frame x:Name="frame" NavigationUIVisibility="Hidden" Margin="0,50,0,0"/>
    </Grid>
</Window>
